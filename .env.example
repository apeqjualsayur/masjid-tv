# Copy this file to .env.local (never committed) and fill in the values from
# Supabase dashboard -> Project Settings -> API (project masjidview-dev).

# Public by design (RLS protects the data). New-style "publishable" keys also work.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public. The Web OAuth client ID (Google Cloud -> Credentials; the same one as in Supabase ->
# Authentication -> Providers -> Google). Set: Google's own button, whose window says
# "to continue to masjidview.my". Unset: the redirect sign-in via the Supabase address.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# SECRET. Only for local scripts such as `npm run rls-check`. Never in app code,
# never in a NEXT_PUBLIC_ variable, never in a commit. New-style "secret" keys also work.
SUPABASE_SERVICE_ROLE_KEY=

# Admin feature switch (src/config/features.ts): 1 shows the 4 round-2 themes and the
# "Pengumuman sahaja" layout. Leave unset for production builds.
# NEXT_PUBLIC_THEMES_ROUND2=1