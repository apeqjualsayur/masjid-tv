# Cloudflare Pages response headers (copied to out/_headers by the build).

# Service worker and config must always be re-checked, or TVs keep an old version.
/sw.js
  Cache-Control: no-cache
/config/*
  Cache-Control: no-cache
/data/*
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# Android TV app (.github/workflows/android-tv.yml): always the newest file, downloaded (not opened).
/apk/*
  Cache-Control: no-cache
/apk/*.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="masjidview-tv.apk"

# Hashed build files never change: cache for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin